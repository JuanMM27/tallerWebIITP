# Copiá este archivo como ".env" y completá los valores.
# El .env NO se sube a GitHub: tiene datos privados.

# Conexión a MongoDB. Pedile la de la base compartida al equipo,
# o usá una base local:
MONGODB_URI=mongodb://127.0.0.1:27017/terra

# Puerto donde corre el backend
PORT=4000

# Clave para firmar los tokens JWT: cualquier texto largo y difícil de adivinar
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# URL del frontend: se usa para armar el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:4200

# Opcional: servidor de correo para los mails de recuperación de contraseña.
# Si no se completa, se usa una cuenta de prueba de Ethereal y el enlace para ver
# el mail aparece en la consola del backend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=contraseña_de_aplicacion
# MAIL_FROM=Terra Café <tu_correo@gmail.com>

# Opcional: datos del administrador que crea "npm run crear-admin"
# ADMIN_CORREO=admin@terra.com
# ADMIN_PASSWORD=Admin123!
